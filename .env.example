# ── Kalshi credentials ────────────────────────────────────────────────────────
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# ── Environment ──────────────────────────────────────────────────────────────
KALSHI_DEMO_MODE=true
# KALSHI_BASE_URL=https://api.elections.kalshi.com
# KALSHI_DEMO_URL=https://demo-api.kalshi.co

# ── Risk limits (all non-negotiable) ─────────────────────────────────────────
# STARTING_BANKROLL=100.0
# MAX_DAILY_LOSS=3.0
# MAX_TOTAL_EXPOSURE=20.0
# MAX_CONCURRENT_MARKETS=6
# MAX_PER_MARKET_NOTIONAL=5.0
# MAX_PER_ORDER_NOTIONAL=2.0

# ── Fee model ────────────────────────────────────────────────────────────────
# MAKER_FEE_PER_CONTRACT=0.01
# TAKER_FEE_PER_CONTRACT=0.03
# SLIPPAGE_BUFFER_TICKS=2

# ── Rate limits ──────────────────────────────────────────────────────────────
# READ_RATE_LIMIT=20
# WRITE_RATE_LIMIT=10

# ── Market filter ───────────────────────────────────────────────────────────
# MIN_BOOK_DEPTH=5
# MIN_SPREAD_NET_CENTS=2
# MAX_TIME_TO_EXPIRY_DAYS=30

# ── Market maker strategy ───────────────────────────────────────────────────
# MM_QUOTE_REFRESH_SECS=10
# MM_MIN_PRICE_MOVE_TICKS=1
# MM_ADVERSE_MOVE_TICKS=3
# MM_ADVERSE_WINDOW_SECS=10
# MM_COOLDOWN_SECS=300

# ── Event reversion strategy ────────────────────────────────────────────────
# ER_ROLLING_WINDOW=60
# ER_ENTRY_ZSCORE=2.0
# ER_MAX_NOTIONAL=1.0
# ER_STOP_LOSS_TICKS=5
# ER_TAKE_PROFIT_TICKS=3

# ── Category allowlist ──────────────────────────────────────────────────────
# ALLOW_SPORTS=true
# ALLOW_NON_SPORTS=true

# ── Database ─────────────────────────────────────────────────────────────────
# DB_PATH=data/trading.db

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FILE=logs/bot.jsonl
